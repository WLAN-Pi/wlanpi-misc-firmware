#!/bin/bash
set -e

# Remove diversions when package is removed or purged
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    # Remove diversions for all MediaTek firmware files
    for f in mediatek/BT_RAM_CODE_MT7922_1_1_hdr.bin \
             mediatek/WIFI_RAM_CODE_MT7922_1.bin \
             mediatek/WIFI_MT7922_patch_mcu_1_1_hdr.bin \
             mediatek/WIFI_RAM_CODE_MT7961_1.bin \
             mediatek/WIFI_MT7961_patch_mcu_1_2_hdr.bin \
             mediatek/BT_RAM_CODE_MT7961_1_2_hdr.bin \
             mediatek/mt7610u.bin \
             mediatek/mt7610e.bin \
             mt7662.bin \
             mt7662_rom_patch.bin \
             mediatek/mt7925/BT_RAM_CODE_MT7925_1_1_hdr.bin \
             mediatek/mt7925/WIFI_MT7925_PATCH_MCU_1_1_hdr.bin \
             mediatek/mt7925/WIFI_RAM_CODE_MT7925_1_1.bin \
             mediatek/BT_RAM_CODE_MT7902_1_1_hdr.bin \
             mediatek/WIFI_MT7902_patch_mcu_1_1_hdr.bin \
             mediatek/WIFI_RAM_CODE_MT7902_1.bin \
             mediatek/BT_RAM_CODE_MT7961_1a_2_hdr.bin \
             mediatek/WIFI_MT7961_patch_mcu_1a_2_hdr.bin \
             mediatek/WIFI_RAM_CODE_MT7961_1a.bin \
             mediatek/mt7601u.bin \
             mediatek/mt7615_cr4.bin \
             mediatek/mt7615_n9.bin \
             mediatek/mt7615_rom_patch.bin \
             mediatek/mt7622_n9.bin \
             mediatek/mt7622_rom_patch.bin \
             mediatek/mt7622pr2h.bin \
             mediatek/mt7650.bin \
             mediatek/mt7650e.bin \
             mediatek/mt7662.bin \
             mediatek/mt7662_rom_patch.bin \
             mediatek/mt7662u.bin \
             mediatek/mt7662u_rom_patch.bin \
             mediatek/mt7663_n9_rebb.bin \
             mediatek/mt7663_n9_v3.bin \
             mediatek/mt7663pr2h.bin \
             mediatek/mt7663pr2h_rebb.bin \
             mediatek/mt7668pr2h.bin \
             mediatek/mt7915_eeprom.bin \
             mediatek/mt7915_eeprom_dbdc.bin \
             mediatek/mt7915_rom_patch.bin \
             mediatek/mt7915_wa.bin \
             mediatek/mt7915_wm.bin \
             mediatek/mt7916_eeprom.bin \
             mediatek/mt7916_rom_patch.bin \
             mediatek/mt7916_wa.bin \
             mediatek/mt7916_wm.bin \
             mediatek/mt7927/WIFI_MT6639_PATCH_MCU_2_1_hdr.bin \
             mediatek/mt7927/WIFI_RAM_CODE_MT6639_2_1.bin \
             mt7601u.bin \
             mt7650.bin \
             rt2561.bin \
             rt2561s.bin \
             rt2661.bin \
             rt2860.bin \
             rt2870.bin \
             rt3071.bin \
             rt3290.bin \
             rt73.bin \
             ath12k/WCN7850/hw2.0/amss.bin \
             ath12k/WCN7850/hw2.0/board-2.bin \
             ath12k/WCN7850/hw2.0/m3.bin \
             ath12k/WCN7850/hw2.0/ncm865/amss.bin \
             ath12k/WCN7850/hw2.0/ncm865/m3.bin; do
        dpkg-divert --package wlanpi-misc-firmware --no-rename --quiet \
            --remove "/usr/lib/firmware/$f" || true
    done
fi

#DEBHELPER#

# Remove files created by postinst on purge
if [ "$1" = "purge" ]; then
    rm -f /etc/modules-load.d/mt7921u.conf \
          /etc/modules-load.d/mt7925u.conf \
          /etc/udev/rules.d/99-cf95x.rules \
          /etc/udev/rules.d/99-axe3000.rules \
          /etc/udev/rules.d/99-a9000.rules \
          /etc/udev/hwdb.d/99-wlanpi-be200.hwdb || true
    if command -v systemd-hwdb >/dev/null 2>&1; then
        systemd-hwdb update || true
    fi
fi

exit 0
