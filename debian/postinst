#!/bin/bash

#DEBHELPER#

# Add support for MediaTek mt7921u adapters
echo "mt7921u" > /etc/modules-load.d/mt7921u.conf

# Add support for MediaTek mt7925u adapters
echo "mt7925u" > /etc/modules-load.d/mt7925u.conf

# Remove the udev new_id rules created by earlier versions. The device IDs are
# already in the mt7921u/mt7925u device tables.
rm -f /etc/udev/rules.d/99-cf95x.rules \
      /etc/udev/rules.d/99-axe3000.rules \
      /etc/udev/rules.d/99-a9000.rules

# If this is not being executed by pi-gen during image build process, apply changes immediately without requiring a reboot
if [ -f /etc/wlanpi-release ]; then
    echo "Adding mt7921u kernel module"
    modprobe mt7921u -q
    echo "Adding mt7925u kernel module"
    modprobe mt7925u -q
fi

# Add Intel Corp. BE200 Bluetooth device name to lsusb
HWDB_FILE="/etc/udev/hwdb.d/99-wlanpi-be200.hwdb"
if ! grep -q "usb:v8087p0036" "$HWDB_FILE" 2>/dev/null; then
echo "Adding Intel Corp. BE200 Bluetooth device name to lsusb"
cat >"$HWDB_FILE" <<'EOL'
# Intel Corp. BE200 Bluetooth device name added by WLAN Pi team
usb:v8087p0036*
 ID_MODEL_FROM_DATABASE=BE200 Bluetooth
EOL
# Refresh systemd-hwdb to add the new device
systemd-hwdb update
fi

# Remove the old hwdb file if it contains only the WLAN Pi entry
OLD_HWDB_FILE="/usr/lib/udev/hwdb.d/99-usb-vendor-model.hwdb"
if [ -f "$OLD_HWDB_FILE" ] && grep -q "WLAN Pi team" "$OLD_HWDB_FILE"; then
    if [ "$(grep -cvE '^[[:space:]]*(#|$)' "$OLD_HWDB_FILE")" -le 2 ]; then
        rm -f "$OLD_HWDB_FILE"
        systemd-hwdb update
    fi
fi

exit 0
